# Reference only — this file is not consumed directly. Real values are
# fetched from Google Cloud Secret Manager (project: immoo-506522) and
# written to a gitignored .env.local automatically by direnv on `cd`, or
# manually via `bash scripts/fetch-secrets.sh` (also runs as pnpm's predev).
# See UML/secrets-management.md for how the pieces fit together.

NEXT_PUBLIC_LOCAL_API=http://localhost:3000/api
LOCAL_API=http://localhost:3000/api
PUBLIC_APP_URL=http://localhost:3000

# GOOGLE OAUTH
## LOCAL
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

### Auth Secret — generate with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret

## STAGING
AUTH_GOOGLE_ID_STAGING=your_staging_oauth_client_id
AUTH_GOOGLE_SECRET_STAGING=your_staging_oauth_client_secret

## LIVE
AUTH_GOOGLE_ID_LIVE=your_live_oauth_client_id
AUTH_GOOGLE_SECRET_LIVE=your_live_oauth_client_secret

## API
SCRAPPER_BASE_URL="http://localhost:8000/api"
NEXT_PUBLIC_SCRAPPER_BASE_URL="http://localhost:8000/api"
